# =====================================================================
# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.
# En Netlify, estas mismas variables van en:
# Site configuration > Environment variables
# =====================================================================

# ---------- 1. SUPABASE para la WEB (se incluyen en la página: deben ser públicas) ----------
# Supabase > Project Settings > API Keys
VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 2. SUPABASE para los ENVÍOS (secretas: solo servidor) ----------
SUPABASE_URL=https://abcdefghijklmnop.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 3. CORREO del administrador (Gmail con contraseña de aplicación) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo.del.club@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-letras
MAIL_FROM_NAME=Club de Ingeniería Codepeques

# ---------- 4. WHATSAPP automático (OPCIONAL: déjalo vacío al principio) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=estado_cuenta_club
WHATSAPP_TEMPLATE_LANG=es
